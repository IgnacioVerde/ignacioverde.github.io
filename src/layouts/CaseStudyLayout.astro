---
import BaseLayout from './BaseLayout.astro';
import type { ProjectLink } from '../data/projects';

interface Props {
  title: string;
  subtitle: string;
  eyebrow?: string;
  stack?: string[];
  confidential?: boolean;
  links?: ProjectLink[];
  lang?: 'en' | 'es';
}

const {
  title,
  subtitle,
  eyebrow,
  stack = [],
  confidential = false,
  links = [],
  lang = 'en',
} = Astro.props;

const isEs = lang === 'es';
const resolvedEyebrow = eyebrow ?? (isEs ? 'Case Study' : 'Case Study');
---

<BaseLayout lang={lang} title={`${title} — Ignacio Verde`} description={subtitle}>
  <main>
    <section class="case-hero container">
      <a class="back-link" href={isEs ? '/es/#work' : '/#work'}>{isEs ? '← Volver a proyectos' : '← Back to selected work'}</a>
      <div class="eyebrow">{resolvedEyebrow}</div>
      <h1 class="case-title">{title}</h1>
      <p class="case-subtitle">{subtitle}</p>

      {stack.length > 0 && (
        <div class="stack case-stack">
          {stack.map((item) => <span class="tag">{item}</span>)}
        </div>
      )}

      {links.length > 0 && (
        <div class="case-actions">
          {links.map((link, index) => (
            <a class={`button ${index === 0 ? 'primary' : 'secondary'}`} href={link.url} target="_blank" rel="noreferrer">
              {link.label} ↗
            </a>
          ))}
        </div>
      )}

      {confidential && (
        <div class="confidential-note case-note">
          {isEs ? (
            <><strong>Proyecto confidencial — solo case study.</strong> Esta página omite deliberadamente datos sensibles, información de clientes, endpoints internos, credenciales, código fuente y detalles no públicos de infraestructura.</>
          ) : (
            <><strong>Confidential Project — Case Study Only.</strong> This page intentionally omits sensitive data, customer information, internal endpoints, credentials, source code and non-public infrastructure details.</>
          )}
        </div>
      )}
    </section>

    <section class="case-content container">
      <slot />
    </section>
  </main>
</BaseLayout>
