---
import { capabilities, capabilitiesEs } from '../data/projects';
interface Props { lang?: 'en' | 'es'; }
const { lang = 'en' } = Astro.props;
const isEs = lang === 'es';
const items = isEs ? capabilitiesEs : capabilities;
---
<section id="capabilities" class="section container">
  <div class="section-heading">
    <div>
      <div class="eyebrow compact">{isEs ? 'Capacidades' : 'Capabilities'}</div>
      <h2>{isEs ? 'A través de todo el stack.' : 'Across the whole stack.'}</h2>
    </div>
    <p>
      {isEs
        ? 'Mi trabajo cruza con frecuencia los límites entre desarrollo de aplicaciones, infraestructura, integración, operaciones y automatización.'
        : 'My work frequently crosses the boundary between application development, infrastructure, integration, operations and automation.'}
    </p>
  </div>
  <div class="capability-grid">
    {items.map((capability, index) => (
      <div class="capability">
        <span class="capability-index">{String(index + 1).padStart(2, '0')}</span>
        <span>{capability}</span>
      </div>
    ))}
  </div>
</section>
