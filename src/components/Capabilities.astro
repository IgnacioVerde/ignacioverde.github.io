---
import { capabilities } from '../data/projects';
---

<section id="capabilities" class="section container">
  <div class="section-heading">
    <div>
      <div class="eyebrow compact">Capabilities</div>
      <h2>Across the whole stack.</h2>
    </div>
    <p>
      My work frequently crosses the boundary between application development,
      infrastructure, integration, operations and automation.
    </p>
  </div>

  <div class="capability-grid">
    {capabilities.map((capability, index) => (
      <div class="capability">
        <span class="capability-index">{String(index + 1).padStart(2, '0')}</span>
        <span>{capability}</span>
      </div>
    ))}
  </div>
</section>
