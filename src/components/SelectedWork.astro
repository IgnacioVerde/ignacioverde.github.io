---
import ProjectCard from './ProjectCard.astro';
import { projects } from '../data/projects';

const featuredProjects = projects.filter((project) => project.featured);
---

<section id="work" class="section container">
  <div class="section-heading">
    <h2>Selected Work</h2>
    <p>
      A selection of production systems, personal projects and automation tools
      spanning modern applications, legacy infrastructure and operational workflows.
    </p>
  </div>

  <div class="projects">
    {featuredProjects.map((project) => <ProjectCard project={project} />)}
  </div>
</section>
