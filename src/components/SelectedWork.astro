---
import ProjectCard from './ProjectCard.astro';
import { projects } from '../data/projects';

const featuredProjects = projects.filter((project) => project.featured);
---

<section id="work" class="section container">
  <div class="section-heading">
    <div>
      <div class="eyebrow compact">Selected Work</div>
      <h2>Systems, not exercises.</h2>
    </div>
    <p>
      Production systems, open-source projects and confidential professional work
      spanning modern applications, legacy infrastructure and operational automation.
    </p>
  </div>

  <div class="projects">
    {featuredProjects.map((project) => <ProjectCard project={project} />)}
  </div>
</section>
