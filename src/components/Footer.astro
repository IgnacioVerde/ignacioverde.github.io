---
interface Props {
  lang?: 'en' | 'es';
}

const { lang = 'en' } = Astro.props;
const isEs = lang === 'es';

const cvUrl = isEs
  ? '/cv/Ignacio_Verde_CV_ES.pdf'
  : '/cv/Ignacio_Verde_CV_EN.pdf';
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div>
      <div class="footer-name">
        Ignacio Verde
      </div>

      <div class="footer-role">
        {isEs
          ? 'Ingeniero de Software · Full-Stack · Infraestructura · Automatización'
          : 'Software Engineer · Full-Stack · Infrastructure · Automation'}
      </div>
    </div>

    <div class="footer-links">
      <a
        href="https://github.com/IgnacioVerde"
        target="_blank"
        rel="noreferrer"
      >
        GitHub
      </a>

      <a
        href="https://www.linkedin.com/in/ignacio-verde-34a812300/"
        target="_blank"
        rel="noreferrer"
      >
        LinkedIn
      </a>

      <a
        href={cvUrl}
        download
      >
        {isEs ? 'Descargar CV' : 'Download CV'}
      </a>

      <a href={isEs ? '/es/#work' : '/#work'}>
        {isEs ? 'Proyectos' : 'Projects'}
      </a>
    </div>
  </div>
</footer>