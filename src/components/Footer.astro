---
interface Props { lang?: 'en' | 'es'; }
const { lang = 'en' } = Astro.props;
const isEs = lang === 'es';
---
<footer class="site-footer">
  <div class="container footer-inner">
    <div>
      <div class="footer-name">Ignacio Verde</div>
      <div class="footer-role">{isEs ? 'Ingeniero de Software · Full-Stack · Infraestructura · Automatización' : 'Software Engineer · Full-Stack · Infrastructure · Automation'}</div>
    </div>
    <div class="footer-links">
      <a href="https://github.com/IgnacioVerde" target="_blank" rel="noreferrer">GitHub</a>
      <a href="https://github.com/IgnacioVerde/ignacioverde.github.io" target="_blank" rel="noreferrer">{isEs ? 'Código del Portfolio' : 'Portfolio Source'}</a>
      <a href={isEs ? '/es/#work' : '/#work'}>{isEs ? 'Proyectos' : 'Projects'}</a>
    </div>
  </div>
</footer>
