---
interface Props { lang?: 'en' | 'es'; }
const { lang = 'en' } = Astro.props;
const isEs = lang === 'es';
---
<section class="hero container">
  <div class="hero-badge">Full-Stack · Infrastructure · Automation · AI Workflows</div>
  <div class="eyebrow">{isEs ? 'Ingeniero de Software · Argentina' : 'Software Engineer · Argentina'}</div>

  <h1>
    {isEs ? 'Construyo sistemas que' : 'I build systems that'}
    <span class="hero-accent">{isEs ? 'resuelven problemas reales.' : 'solve real problems.'}</span>
  </h1>

  <p class="hero-copy">
    {isEs
      ? 'Diseño, construyo, integro, despliego y opero software web, desktop, cloud y sistemas internos de negocio — especialmente donde se cruzan tecnología legacy, automatización e infraestructura.'
      : 'I design, build, integrate, deploy and operate software across web, desktop, cloud and internal business systems — especially where legacy technology, automation and infrastructure meet.'}
  </p>

  <div class="hero-actions">
    <a class="button primary" href="#work">{isEs ? 'Ver proyectos' : 'Explore my work'}</a>
    <a class="button secondary" href="https://github.com/IgnacioVerde" target="_blank" rel="noreferrer">GitHub ↗</a>
  </div>

  <div class="hero-proof">
    <div><strong>{isEs ? 'Producción' : 'Production'}</strong><span>{isEs ? 'Sistemas desplegados y mantenidos' : 'Systems deployed and maintained'}</span></div>
    <div><strong>End-to-end</strong><span>{isEs ? 'Responsabilidad sobre software + infraestructura' : 'Software + infrastructure ownership'}</span></div>
    <div><strong>Legacy → Modern</strong><span>{isEs ? 'Integración, migración y automatización' : 'Integration, migration and automation'}</span></div>
  </div>
</section>
